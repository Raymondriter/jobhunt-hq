@model JobHuntHQ.Models.ApplicationFormViewModel

@{
    ViewData["Title"] = "Add application";
}

<h1>Add application</h1>

<form asp-action="Create" method="post" class="edit-form">
    <partial name="_ApplicationForm" model="Model" />
    <div class="form-actions">
        <button type="submit" class="button">Save application</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>
