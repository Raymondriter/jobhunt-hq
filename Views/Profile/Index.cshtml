@model JobHuntHQ.Models.SearchProfile
@using JobHuntHQ.Models
@using JobHuntHQ.Services

@{
    ViewData["Title"] = "Search profile";
    var apiTokens = ViewData["ApiTokens"] as List<ApiToken> ?? new List<ApiToken>();
    var newPlainToken = TempData["NewApiTokenPlaintext"] as string;
    var newTokenName = TempData["NewApiTokenName"] as string;
}

<div class="page-heading">
    <h1>Search profile</h1>
    @if (Model is not null)
    {
        <span class="heading-actions">
            <a class="button" asp-action="Edit">Edit profile</a>
            <form asp-action="RecheckAll" method="post">
                <button type="submit" class="button button-secondary">Re-check all applications</button>
            </form>
        </span>
    }
</div>

@if (Model is null)
{
    <p class="empty-note">
        You haven't saved a search profile yet. Your profile holds the criteria
        JobHunt HQ checks new postings against — your target roles, pay floor,
        must-haves, deal-breakers, and the companies you skip — plus the
        standing answers you reuse on applications.
    </p>
    <p><a class="button" asp-action="Edit">Create your search profile</a></p>
}
else
{
    var targetRoles = FitCheckService.ParseList(Model.TargetRoles);
    var mustHaves = FitCheckService.ParseList(Model.MustHaves);
    var dealBreakers = FitCheckService.ParseList(Model.DealBreakers);
    var skipCompanies = FitCheckService.ParseList(Model.SkipCompanies);

    <p class="page-note">These are your own criteria — fit checks on your postings are scored deterministically against each keyword below.</p>

    <dl class="detail-list">
        @if (targetRoles.Count > 0)
        {
            <dt>Target roles</dt>
            <dd>
                <div class="keyword-chips">
                    @foreach (var kw in targetRoles)
                    {
                        <span class="keyword-chip">@kw</span>
                    }
                </div>
            </dd>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RemotePreference))
        {
            <dt>Remote preference</dt>
            <dd>@Model.RemotePreference</dd>
        }
        @if (Model.PayFloor.HasValue)
        {
            <dt>Pay floor</dt>
            <dd><strong>$@Model.PayFloor.Value.ToString("N0")</strong> / year</dd>
        }
        @if (mustHaves.Count > 0)
        {
            <dt>Must-haves</dt>
            <dd>
                <div class="keyword-chips">
                    @foreach (var kw in mustHaves)
                    {
                        <span class="keyword-chip keyword-chip-good">@kw</span>
                    }
                </div>
            </dd>
        }
        @if (dealBreakers.Count > 0)
        {
            <dt>Deal-breakers</dt>
            <dd>
                <div class="keyword-chips">
                    @foreach (var kw in dealBreakers)
                    {
                        <span class="keyword-chip keyword-chip-warn">@kw</span>
                    }
                </div>
            </dd>
        }
        @if (skipCompanies.Count > 0)
        {
            <dt>Skip companies</dt>
            <dd>
                <div class="keyword-chips">
                    @foreach (var kw in skipCompanies)
                    {
                        <span class="keyword-chip keyword-chip-warn">@kw</span>
                    }
                </div>
            </dd>
        }
        <dt>Last updated</dt>
        <dd>@Model.UpdatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</dd>
    </dl>

    <div class="section-heading">
        <h2>Standing answers</h2>
        @if (!string.IsNullOrWhiteSpace(Model.StandingAnswers))
        {
            <button type="button" class="button button-secondary button-small" id="copy-standing-answers" data-copy="@Model.StandingAnswers">Copy standing answers</button>
        }
    </div>
    @if (string.IsNullOrWhiteSpace(Model.StandingAnswers))
    {
        <p class="empty-note">No standing answers saved yet — <a asp-action="Edit">add them</a> so they're one copy away on every application.</p>
    }
    else
    {
        <pre class="code-block notes-block">@Model.StandingAnswers</pre>
    }
}

<section class="dashboard-section" id="api-tokens">
    <h2>Personal API tokens (Bring-Your-Own-AI)</h2>
    <p class="page-note">
        Connect your own AI assistant or CLI directly to <code>/api/v1</code> (read your profile and pipeline, capture postings, run fit checks, and fetch Application or Interview AI packets). Tokens are stored only as SHA-256 hashes and can be revoked immediately. <strong>JobHunt HQ's API has no submit endpoint — ever.</strong>
    </p>

    @if (!string.IsNullOrWhiteSpace(newPlainToken))
    {
        <div class="flash-banner flash-success" role="status">
            <strong>Copy your new token for "@newTokenName" now — it will never be shown again:</strong>
            <div class="button-row" style="margin-top: 0.45rem;">
                <code id="new-api-token-code" style="background: #fff; padding: 0.35rem 0.6rem; border-radius: 6px; border: 1px solid #b7e1c7; user-select: all;">@newPlainToken</code>
                <button type="button" class="button button-small" id="copy-new-token" data-copy="@newPlainToken">Copy token</button>
            </div>
        </div>
    }

    @if (apiTokens.Count > 0)
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Prefix</th>
                        <th>Scopes</th>
                        <th>Created</th>
                        <th>Last used</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in apiTokens)
                    {
                        <tr>
                            <td><strong>@t.Name</strong></td>
                            <td><code>@t.TokenPrefix…</code></td>
                            <td><span class="file-meta">@t.Scopes</span></td>
                            <td>@t.CreatedUtc.ToString("yyyy-MM-dd")</td>
                            <td>@(t.LastUsedUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Never")</td>
                            <td class="row-actions">
                                <form asp-action="RevokeToken" asp-route-id="@t.Id" method="post">
                                    <button type="submit" class="link-button" style="color: #b3261e;">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <details class="packet-preview-details">
        <summary><strong>+ Create a new personal API token</strong></summary>
        <form asp-action="CreateToken" method="post" class="prepare-workspace-box workspace-form">
            <div class="form-row">
                <label for="token-name">Token name</label>
                <input type="text" id="token-name" name="name" required maxlength="100" placeholder="e.g. Claude Code, Antigravity Agent, Codex CLI" />
            </div>
            <div class="form-row">
                <label>Scopes (least privilege)</label>
                <div class="form-grid" style="margin-top: 0.35rem;">
                    @foreach (var (scope, desc) in ApiToken.AllScopes)
                    {
                        var defaultChecked = scope.EndsWith(":read", StringComparison.Ordinal)
                            || scope == "fitcheck:run"
                            || scope == "packets:generate";
                        <label class="board-toggle-label" style="padding: 0.25rem 0;">
                            <input type="checkbox" name="scopes" value="@scope" checked="@defaultChecked" />
                            <span><code>@scope</code> — @desc</span>
                        </label>
                    }
                </div>
            </div>
            <button type="submit" class="button">Generate token</button>
        </form>
    </details>

    <details class="packet-preview-details" style="margin-top: 0.85rem;">
        <summary><strong>Connect Muse or your own AI agent (centralized sync instructions)</strong></summary>
        @{
            var hostBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
            var museInstructions =
$@"Use JobHunt HQ ({hostBase}) as the single source of truth for my job search using Authorization: Bearer <YOUR_JHQ_TOKEN>:

1. Read my current search criteria & standing answers before scanning or preparing:
   GET {hostBase}/api/v1/profile

2. Report every prepared or submitted application outcome idempotently (safe to retry — never duplicates or downgrades interviews):
   POST {hostBase}/api/v1/sync/outcome
   Content-Type: application/json
   {{
     ""attemptId"": ""muse-<company-slug>-<role-slug>"",
     ""sourceAgent"": ""Muse"",
     ""outcome"": ""confirmed"" | ""interrupted"",
     ""company"": ""Example Corp"",
     ""roleTitle"": ""Senior Software Engineer"",
     ""url"": ""https://..."",
     ""location"": ""Remote (US)"",
     ""dateApplied"": ""2026-11-24"",
     ""payMin"": 130000,
     ""payMax"": 160000,
     ""postingText"": ""..."",
     ""confirmationReference"": ""ATS confirmation email/ID when submitted"",
     ""blockingQuestion"": ""Exact question needing my answer when interrupted before submit""
   }}

3. Bulk-sync a scan batch or Gmail confirmation sweep in one call:
   POST {hostBase}/api/v1/sync/batch  (body: {{ ""items"": [ ... ] }})

4. Pull a fact-locked Application Packet or Interview Prep Packet:
   GET {hostBase}/api/v1/applications/{{id}}/packet?format=md
   GET {hostBase}/api/v1/applications/{{id}}/interview-packet?format=md";
        }
        <div class="prepare-workspace-box workspace-form">
            <div class="ready-prompt-header">
                <span class="table-note">Give this contract to <strong>Muse</strong> (with a token scoped to <code>profile:read</code>, <code>applications:read</code>, <code>applications:write</code>, <code>packets:generate</code>) so every scan match, paused question, and confirmed submission lands in JobHunt HQ automatically.</span>
                <button type="button" class="button button-secondary button-small" id="copy-muse-contract" data-copy="@museInstructions">Copy Muse instructions</button>
            </div>
            <pre class="code-block notes-block" style="margin: 0.5rem 0 0; font-size: 0.85rem;">@museInstructions</pre>
        </div>
    </details>
</section>

<section class="dashboard-section">
    <h2>Your data</h2>
    <p>
        Everything JobHunt HQ holds for you — your search profile, every
        application with all its fields and interview rounds, your STAR Story
        Bank, and your resume version details — in one JSON file, or your
        applications as a spreadsheet-ready CSV. Resume PDF files can be
        downloaded individually from the Resumes page.
    </p>
    <p class="button-row">
        <a class="button button-secondary" asp-action="Export">Download my data (JSON)</a>
        <a class="button button-secondary" asp-action="ExportCsv">Download applications (.csv)</a>
    </p>
    <p class="page-note">
        What the app stores, why, and how to delete it:
        <a asp-controller="Home" asp-action="Privacy">the Privacy page</a>.
    </p>

    <details class="packet-preview-details" style="margin-top: 1.25rem;">
        <summary><strong>Danger zone: delete all tracked data &amp; uploaded resume PDFs</strong></summary>
        <form asp-action="DeleteAllMyData" method="post" class="prepare-workspace-box workspace-form" style="border-color: #f1b8b8;">
            <p class="page-note" style="margin-top: 0;">
                Permanently deletes all of your tracked applications, interview rounds, STAR stories, search profile, and uploaded resume PDFs while keeping your sign-in account (or right before you close your account under <strong>Account &rarr; Personal data</strong>). This cannot be undone.
            </p>
            <div class="button-row">
                <label for="confirm-wipe" class="visually-hidden">Type DELETE to confirm</label>
                <input type="text" id="confirm-wipe" name="confirmText" placeholder="Type DELETE to confirm" style="max-width: 14rem; padding: 0.45rem 0.65rem; border: 1px solid var(--line); border-radius: 8px;" />
                <button type="submit" class="button button-danger">Permanently delete my app data</button>
            </div>
        </form>
    </details>
</section>

@section Scripts {
    <script>
        function wireProfileCopy(id) {
            document.getElementById(id)?.addEventListener('click', async function (e) {
                var btn = e.currentTarget;
                var orig = btn.textContent;
                try {
                    await navigator.clipboard.writeText(btn.getAttribute('data-copy') || '');
                    btn.textContent = 'Copied ✓';
                } catch {
                    btn.textContent = 'Copy failed';
                }
                setTimeout(function () { btn.textContent = orig; }, 2200);
            });
        }
        wireProfileCopy('copy-standing-answers');
        wireProfileCopy('copy-new-token');
        wireProfileCopy('copy-muse-contract');
    </script>
}
