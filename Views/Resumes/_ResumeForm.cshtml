@model JobHuntHQ.Models.ResumeFormViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<div class="form-row">
    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="field-error"></span>
</div>

<div class="form-row">
    <label asp-for="Notes"></label>
    <textarea asp-for="Notes" rows="4"></textarea>
    <span asp-validation-for="Notes" class="field-error"></span>
</div>
