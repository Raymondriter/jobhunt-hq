@model JobHuntHQ.Models.ResumeVersion

@{
    ViewData["Title"] = "Delete resume version";
}

<h1>Delete resume version</h1>

<p class="confirm-note">
    Are you sure you want to delete this resume version? Applications that used
    it keep their history — they just lose the resume link. This cannot be undone.
</p>

<dl class="detail-list">
    <dt>Name</dt>
    <dd>@Model.Name</dd>
    <dt>Notes</dt>
    <dd>@(Model.Notes ?? "—")</dd>
    <dt>Added</dt>
    <dd>@Model.CreatedUtc.ToString("yyyy-MM-dd")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-actions">
        <button type="submit" class="button button-danger">Delete</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>
