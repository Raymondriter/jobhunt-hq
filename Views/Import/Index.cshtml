@{
    ViewData["Title"] = "Import applications";
}

<h1>Quick-update &amp; import applications</h1>

<section class="dashboard-section prepare-workspace-box" id="email-import">
    <h2>Paste any job email (confirmation, rejection, or interview invite)</h2>
    <p class="page-note">
        No Gmail sign-in or AI setup needed — paste any email from Workday, Lever, Ashby, Workable, Greenhouse, NEOGOV, or Microsoft Teams/Zoom.
        JobHunt HQ automatically detects the company, role, status (Applied / Interview / Rejected), and any interview date or call link.
    </p>
    <form asp-action="ParseEmail" method="post" class="workspace-form">
        <div class="form-row">
            <label for="rawEmailText">Email text (include Subject/From lines if handy)</label>
            <textarea id="rawEmailText" name="rawEmailText" rows="6" required placeholder="Paste the confirmation, rejection, or interview invite email here…"></textarea>
        </div>
        <div class="form-grid">
            <div class="form-row">
                <label for="companyOverride">Company override (optional)</label>
                <input type="text" id="companyOverride" name="companyOverride" maxlength="200" placeholder="Auto-detected if left blank" />
            </div>
            <div class="form-row">
                <label for="roleOverride">Role title override (optional)</label>
                <input type="text" id="roleOverride" name="roleOverride" maxlength="200" placeholder="Auto-detected if left blank" />
            </div>
        </div>
        <button type="submit" class="button">Detect &amp; save to tracker</button>
    </form>
</section>

<h2 style="margin-top: 2rem;">Import applications from CSV</h2>

<p>
    Upload a <code>.csv</code> file (up to 2 MB) with one application per row.
    The first row must be a header row. Imported rows are added to
    <em>your</em> applications — if you re-import the same file, rows matching an
    existing application (same Company, Title, DateApplied, and Url) are
    automatically skipped so duplicates aren't created.
</p>

<h2>Expected format</h2>
<p>Column names are matched case-insensitively. Only <strong>Company</strong> and <strong>Title</strong> are required; everything else is optional.</p>

<table class="data-table format-table">
    <thead>
        <tr><th>Column</th><th>Notes</th></tr>
    </thead>
    <tbody>
        <tr><td>Company</td><td>Required.</td></tr>
        <tr><td>Title</td><td>Required. <code>RoleTitle</code> is accepted too.</td></tr>
        <tr><td>Url</td><td>Link to the posting.</td></tr>
        <tr><td>Location</td><td>Free text, e.g. "Remote (US)".</td></tr>
        <tr><td>Status</td><td>One of Saved, Applied, Screening, Interview, Offer, Rejected, Ghosted, Withdrawn. Anything else imports as Saved with a warning.</td></tr>
        <tr><td>DateApplied</td><td><code>yyyy-MM-dd</code> or <code>M/d/yyyy</code>. Also used as the saved date, since most trackers don't track one separately.</td></tr>
        <tr><td>NextAction</td><td>Free text.</td></tr>
        <tr><td>NextActionDue</td><td><code>yyyy-MM-dd</code> or <code>M/d/yyyy</code>.</td></tr>
        <tr><td>SalaryMin</td><td>Whole dollars, e.g. <code>120000</code>.</td></tr>
        <tr><td>SalaryMax</td><td>Whole dollars, e.g. <code>150000</code>.</td></tr>
        <tr><td>ResumeName</td><td>Matched against your resume versions by name; unmatched names are ignored with a warning.</td></tr>
        <tr><td>Notes</td><td>Free text.</td></tr>
    </tbody>
</table>

<p>Example header + row:</p>
<pre class="code-block">Company,Title,Status,DateApplied,SalaryMin,SalaryMax
Example Corp,Senior Software Engineer,Applied,2026-11-01,120000,150000</pre>

<form asp-action="Index" method="post" enctype="multipart/form-data" class="edit-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <div class="form-row">
        <label for="csvFile">CSV file</label>
        <input type="file" id="csvFile" name="csvFile" accept=".csv" />
    </div>
    <div class="form-actions">
        <button type="submit" class="button">Import CSV</button>
        <a asp-controller="Applications" asp-action="Index">Cancel</a>
    </div>
</form>

<section class="dashboard-section">
    <h2>Try with sample demo data</h2>
    <p class="page-note">
        Want to explore the pipeline board, follow-up triage, and AI packets right away? Load the four fictional sample applications from <code>seed/applications-seed.csv</code> with one click.
    </p>
    <form asp-action="LoadDemoSeed" method="post">
        <button type="submit" class="button button-secondary">Load 4 sample demo applications</button>
    </form>
</section>
