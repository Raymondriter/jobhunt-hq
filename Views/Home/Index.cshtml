@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1>JobHunt HQ</h1>
    <p class="pitch">Track every application, never miss a follow-up.</p>
    <p class="hero-sub">
        One calm place for your whole job search — every posting you save, every
        application you send, and every next step, all in a single pipeline.
    </p>
</section>

<section class="pipeline-section">
    <h2>Your search, as a pipeline</h2>
    <p>
        Every opportunity moves through the same five stages, so you always know
        where things stand and what needs your attention next.
    </p>
    <ol class="pipeline">
        <li class="stage">Saved</li>
        <li class="stage">Applied</li>
        <li class="stage">Screening</li>
        <li class="stage">Interview</li>
        <li class="stage stage-final">Offer</li>
    </ol>
    <p class="pipeline-note">
        Roles that don't work out land in Rejected, Ghosted, or Withdrawn — out of
        the way, but never lost.
    </p>
</section>

<section class="features">
    <div class="feature">
        <h3>Next actions, not noise</h3>
        <p>Each application carries a next action and a due date, so follow-ups happen on time instead of by luck.</p>
    </div>
    <div class="feature">
        <h3>The right resume, every time</h3>
        <p>Keep resume versions on file and record which one went to which application.</p>
    </div>
    <div class="feature">
        <h3>A dashboard that answers back</h3>
        <p>Counts by stage, follow-ups due this week, and your response rate at a glance.</p>
    </div>
</section>

<section class="status-section">
    <h2>Project status</h2>
    <ul class="status-list">
        <li>
            <span class="status-badge status-active">In progress</span>
            <strong>M1 — Azure foundation.</strong>
            The app is live on Azure App Service; wiring up continuous deployment from GitHub.
        </li>
        <li>
            <span class="status-badge">Next</span>
            <strong>M2 — The real app.</strong>
            Sign-in, application tracking with full add/edit, and CSV import of real applications.
        </li>
        <li>
            <span class="status-badge">Later</span>
            <strong>M3 — Cloud-native pieces.</strong>
            Resume uploads, a daily follow-up digest, and secrets in Key Vault.
        </li>
    </ul>
</section>
