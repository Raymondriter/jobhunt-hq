<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobHunt HQ</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">JH</span><span class="brand-text">JobHunt HQ<small class="brand-tagline">Track every application</small></span></a>
            <nav class="site-nav">
                <a asp-area="" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Applications" asp-action="Index">Applications</a>
                    <a asp-area="" asp-controller="Board" asp-action="Index">Board</a>
                    <a asp-area="" asp-controller="Resumes" asp-action="Index">Resumes</a>
                    <a asp-area="" asp-controller="Profile" asp-action="Index">Search profile</a>
                    <a asp-area="" asp-controller="Import" asp-action="Index">Import</a>
                }
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <main role="main" class="container site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            &copy; 2026 JobHunt HQ &middot; Track every application, never miss a follow-up. &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
